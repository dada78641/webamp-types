{
  "name": "@dada78641/webamp-types",
  "description": "Webamp types in a single file, compatible with NodeNext module resolution",
  "version": "2.2.0-types.1",
  "type": "module",
  "types": "dist/types.d.mts",
  "sideEffects": false,
  "scripts": {
    "build": "cp -r ./node_modules/webamp/built/types/js ./types; rolldown -c rolldown.config.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "readme.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dada78641/webamp-types.git"
  },
  "license": "MIT",
  "dependencies": {
  },
  "devDependencies": {
    "rolldown": "^1.0.0-rc.2",
    "rolldown-plugin-dts": "^0.21.8",
    "typescript": "^5.9.3",
    "webamp": "^2.2.0"
  }
}
